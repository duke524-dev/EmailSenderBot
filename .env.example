# Choose one provider example and copy it to .env:
#
#   copy .env.example.privateemail .env
#   copy .env.example.ionos .env
#
# Or with Python:
#   python -m mailbot init --provider privateemail
#   python -m mailbot init --provider ionos
#
# Then edit .env and set SMTP_PASSWORD and PHYSICAL_ADDRESS.
# Do not commit .env.
