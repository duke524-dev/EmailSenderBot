# Namecheap Private Email
# Copy this file to .env, then fill in SMTP_PASSWORD and PHYSICAL_ADDRESS.
# In the Private Email panel, turn on SMTP under Connect third-party apps.
# Use the mailbox password, or an app password if you created one.
# Do not commit .env.

SMTP_HOST=mail.privateemail.com
SMTP_PORT=465
SMTP_SECURITY=ssl
SMTP_USERNAME=davidyang@hirelens.us
SMTP_PASSWORD=

FROM_NAME=HireLens
FROM_EMAIL=davidyang@hirelens.us
REPLY_TO=davidyang@hirelens.us

# Postal address printed on every marketing message.
PHYSICAL_ADDRESS=

# Apply Now button link used in hiring email templates.
APPLY_URL=https://forms.gle/d5ifR5Htk7jwRxmC9

# Public https origin for unsubscribe links, with no trailing slash.
# Leave blank until the unsubscribe server is reachable on the internet.
# Blank uses a reply-to unsubscribe link instead.
PUBLIC_BASE_URL=

# Paid plans allow 500 messages per hour per mailbox. Trial plans allow 20.
# This default stays under the trial cap. On a paid mailbox, 400 is a safe ceiling.
HOURLY_LIMIT=15
