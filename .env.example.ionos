# IONOS Mail Business
# Copy this file to .env, then fill in SMTP_PASSWORD and PHYSICAL_ADDRESS.
# Webmail is https://mailbusiness.ionos.com/ — SMTP host is smtp.ionos.com.
# Username is the full mailbox address. Password is the mailbox password.
# Do not commit .env.

SMTP_HOST=smtp.ionos.com
SMTP_PORT=465
SMTP_SECURITY=ssl
SMTP_USERNAME=brandon.walker@noctyra.org
SMTP_PASSWORD=Crazyboy@2026

FROM_NAME=Noctyra
FROM_EMAIL=brandon.walker@noctyra.org
REPLY_TO=brandon.walker@noctyra.org

# Postal address printed on every marketing message.
PHYSICAL_ADDRESS=

# Apply Now button link used in hiring email templates.
APPLY_URL=https://forms.gle/d5ifR5Htk7jwRxmC9

# Public https origin for unsubscribe links, with no trailing slash.
# Leave blank until the unsubscribe server is reachable on the internet.
# Blank uses a reply-to unsubscribe link instead.
PUBLIC_BASE_URL=

# Set this under your IONOS sending limit. Raise only after you know the plan cap.
# If port 465 is blocked on your network, use:
# SMTP_PORT=587
# SMTP_SECURITY=starttls
HOURLY_LIMIT=50
